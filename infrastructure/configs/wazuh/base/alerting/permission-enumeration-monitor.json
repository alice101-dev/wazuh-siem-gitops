{
  "type": "monitor",
  "monitor_type": "bucket_level_monitor",
  "name": "Permission enumeration",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 5,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "wazuh-events-v5-cloud-services"
        ],
        "query": {
          "size": 0,
          "query": {
            "bool": {
              "filter": [
                {
                  "range": {
                    "@timestamp": {
                      "gte": "{{period_end}}||-5m",
                      "lte": "{{period_end}}",
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "event.outcome": "failure"
                  }
                }
              ]
            }
          },
          "aggregations": {
            "composite_agg": {
              "composite": {
                "size": 100,
                "sources": [
                  {
                    "caller": {
                      "terms": {
                        "script": {
                          "lang": "painless",
                          "source": "doc['user.name'].size()!=0 ? doc['user.name'].value : (doc['source.ip'].size()!=0 ? doc['source.ip'].value.toString() : 'unknown')"
                        }
                      }
                    }
                  }
                ]
              },
              "aggs": {
                "methods": {
                  "cardinality": {
                    "field": "event.code"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "bucket_level_trigger": {
        "name": "A caller was denied on 4 or more API methods in 5 minutes",
        "severity": "1",
        "condition": {
          "buckets_path": {
            "methods": "methods"
          },
          "parent_bucket_path": "composite_agg",
          "script": {
            "source": "params.methods >= 4",
            "lang": "painless"
          }
        },
        "actions": [
          {
            "name": "Slack",
            "destination_id": "wazuh-slack",
            "subject_template": {
              "source": "Permission enumeration",
              "lang": "mustache"
            },
            "message_template": {
              "source": "{\"attachments\": [{\"color\": \"#FF1744\", \"mrkdwn_in\": [\"text\"], \"text\": \":rotating_light: *Permission enumeration*\\nCaller: {{#ctx.newAlerts}}`{{bucket_keys}}`{{/ctx.newAlerts}} (principal, or source IP when the denial carries no identity)\\nGoogle Cloud or Kubernetes denied it on 4 or more different API methods between {{ctx.periodStart}} and {{ctx.periodEnd}}, how stolen credentials are probed.\\nIts denied requests: `event.outcome:failure` in wazuh-events-v5-cloud-services.\"}]}",
              "lang": "mustache"
            },
            "throttle_enabled": false,
            "action_execution_policy": {
              "action_execution_scope": {
                "per_alert": {
                  "actionable_alerts": [
                    "NEW"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ]
}
