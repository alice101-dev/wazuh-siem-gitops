{
  "type": "monitor",
  "monitor_type": "query_level_monitor",
  "name": "Falco runtime detection silent",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 5,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "wazuh-events-v5-security"
        ],
        "query": {
          "size": 0,
          "track_total_hits": true,
          "query": {
            "bool": {
              "filter": [
                {
                  "range": {
                    "@timestamp": {
                      "gte": "{{period_end}}||-30m",
                      "lte": "{{period_end}}",
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "rule.name": "Falco canary"
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "query_level_trigger": {
        "name": "No Falco canary reached Wazuh in 30 minutes",
        "severity": "1",
        "condition": {
          "script": {
            "source": "ctx.results[0].hits.total.value == 0",
            "lang": "painless"
          }
        },
        "actions": [
          {
            "name": "Slack",
            "destination_id": "wazuh-slack",
            "subject_template": {
              "source": "Falco runtime detection silent",
              "lang": "mustache"
            },
            "message_template": {
              "source": "{\"attachments\": [{\"color\": \"#FF1744\", \"mrkdwn_in\": [\"text\"], \"text\": \":rotating_light: *Falco runtime detection is silent*\\nNo Falco canary reached Wazuh in the last 30 minutes: Falco, Falcosidekick or the falco-canary CronJob may be down or tampered with, and container activity is not being watched.\\nCheck the falco namespace, then the Pub/Sub path to the GCP collector.\\nChecked: {{ctx.periodEnd}}\"}]}",
              "lang": "mustache"
            },
            "throttle_enabled": true,
            "throttle": {
              "value": 60,
              "unit": "MINUTES"
            }
          }
        ]
      }
    }
  ]
}
