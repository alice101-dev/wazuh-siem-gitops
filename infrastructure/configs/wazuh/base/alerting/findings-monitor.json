{
  "type": "monitor",
  "monitor_type": "doc_level_monitor",
  "name": "Wazuh findings to Slack",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 1,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "doc_level_input": {
        "description": "Findings of level high or critical in every category",
        "indices": [
          "wazuh-findings-v5-access-management",
          "wazuh-findings-v5-applications",
          "wazuh-findings-v5-cloud-services",
          "wazuh-findings-v5-network-activity",
          "wazuh-findings-v5-other",
          "wazuh-findings-v5-security",
          "wazuh-findings-v5-system-activity",
          "wazuh-findings-v5-unclassified"
        ],
        "queries": [
          {
            "id": "high",
            "name": "high",
            "query": "wazuh.rule.level:\"high\"",
            "tags": []
          },
          {
            "id": "critical",
            "name": "critical",
            "query": "wazuh.rule.level:\"critical\"",
            "tags": []
          }
        ]
      }
    }
  ],
  "triggers": [
    {
      "document_level_trigger": {
        "name": "Finding of level high",
        "severity": "2",
        "condition": {
          "script": {
            "source": "query[name=high]",
            "lang": "painless"
          }
        },
        "actions": [
          {
            "name": "Slack high",
            "destination_id": "wazuh-slack",
            "subject_template": {
              "source": "Wazuh finding",
              "lang": "mustache"
            },
            "message_template": {
              "source": "{\"attachments\": [{\"color\": \"#C62828\", \"mrkdwn_in\": [\"text\"], \"text\": \"{{#ctx.alerts}}{{#sample_documents}}:red_circle: *{{_source.wazuh.rule.title}}*\\nLevel: *high* | Category: {{_source.wazuh.integration.category}} | Integration: {{_source.wazuh.integration.name}}\\nAction: `{{_source.event.code}}` by `{{_source.user.name}}`\\nProject: `{{_source.cloud.project.id}}` | Source IP: `{{_source.source.ip}}`\\nMITRE: {{_source.wazuh.rule.mitre.technique.id.0}} {{_source.wazuh.rule.mitre.technique.name.0}}\\nTime: {{_source.@timestamp}}{{^ctx.alerts}}{{_source.wazuh.rule.mitre.technique.id}}{{_source.wazuh.rule.mitre.technique.name}}{{/ctx.alerts}}{{/sample_documents}}{{/ctx.alerts}}\"}]}",
              "lang": "mustache"
            },
            "throttle_enabled": false,
            "action_execution_policy": {
              "action_execution_scope": {
                "per_alert": {
                  "actionable_alerts": [
                    "NEW"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "document_level_trigger": {
        "name": "Finding of level critical",
        "severity": "1",
        "condition": {
          "script": {
            "source": "query[name=critical]",
            "lang": "painless"
          }
        },
        "actions": [
          {
            "name": "Slack critical",
            "destination_id": "wazuh-slack",
            "subject_template": {
              "source": "Wazuh finding",
              "lang": "mustache"
            },
            "message_template": {
              "source": "{\"attachments\": [{\"color\": \"#FF1744\", \"mrkdwn_in\": [\"text\"], \"text\": \"{{#ctx.alerts}}{{#sample_documents}}:rotating_light: *{{_source.wazuh.rule.title}}*\\nLevel: *critical* | Category: {{_source.wazuh.integration.category}} | Integration: {{_source.wazuh.integration.name}}\\nAction: `{{_source.event.code}}` by `{{_source.user.name}}`\\nProject: `{{_source.cloud.project.id}}` | Source IP: `{{_source.source.ip}}`\\nMITRE: {{_source.wazuh.rule.mitre.technique.id.0}} {{_source.wazuh.rule.mitre.technique.name.0}}\\nTime: {{_source.@timestamp}}{{^ctx.alerts}}{{_source.wazuh.rule.mitre.technique.id}}{{_source.wazuh.rule.mitre.technique.name}}{{/ctx.alerts}}{{/sample_documents}}{{/ctx.alerts}}\"}]}",
              "lang": "mustache"
            },
            "throttle_enabled": false,
            "action_execution_policy": {
              "action_execution_scope": {
                "per_alert": {
                  "actionable_alerts": [
                    "NEW"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ]
}
