        "technique": [
          "T1552",
          "Unsecured Credentials"
        ]
      }
    },
    {
      "title": "GCP OAuth client created or changed",
      "level": "high",
      "description": "An OAuth client ID or consent screen was created, changed or deleted on the Credentials page: an app that can ask users for access to their Google data.",
      "selection": {
        "service.name": "clientauthconfig.googleapis.com",
        "event.code|endswith": [
          ".CreateClient",
          ".UpdateClient",
          ".DeleteClient",
          ".CreateBrand",
          ".UpdateBrand"
        ]
      },
      "exclude": {
        "failed": {
          "event.outcome": "failure"
        }
      },
      "mitre": {
        "tactic": [
          "TA0003",
          "Persistence"
        ],
        "technique": [
          "T1098",
          "Account Manipulation"
        ]
      }
    },
    {
      "title": "GCP OS Login SSH key added",
